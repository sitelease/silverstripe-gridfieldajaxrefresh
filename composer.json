{
	"name": "silverstripe/gridfieldajaxrefresh",
	"description": "Adds the ability to either automatically or manually refresh a SilverStripe GridField",
	"type": "silverstripe-vendormodule",
	"keywords": ["silverstripe", "gridfield", "ajax", "refresh", "auto-refresh", "automatic"],
	"license": "BSD-3-Clause",
    "minimum-stability": "dev",
	"authors": [
	{
		"name": "Julian Seidenberg",
		"email": "julian@silverstripe.com"
	}
	],
	"require": {
		"silverstripe/framework": "^5"
	},
	"autoload": {
        "psr-4": {
            "Silverstripe\\GridfieldAjaxRefresh\\": "src/"
        }
    },
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"silverstripe/vendor-plugin": true
		}
	},
    "extra": {
        "expose": [
            "client/dist"
        ]
    }
}
